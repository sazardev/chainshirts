---
import type { GetStaticPaths } from 'astro';
import CatalogFilters from '../../components/islands/CatalogFilters';
import ProductCard from '../../components/ProductCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProducts } from '../../lib/catalog';
import { type Collection, collections, productsForCollection } from '../../lib/collections';
import type { Product } from '../../lib/domain/product';
import { itemListSchema } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection, products: productsForCollection(collection, products) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  collection: Collection;
  products: Product[];
}

const { collection, products } = Astro.props;
const schema = { '@context': 'https://schema.org', '@graph': [itemListSchema(products)] };
---

<BaseLayout
  title={collection.name}
  description={collection.description}
  path={`/collections/${collection.slug}`}
  schema={schema}
>
  <nav aria-label="Breadcrumb" class="text-body-sm text-muted">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a href="/" class="text-link hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/collections" class="text-link hover:underline">Collections</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="font-semibold text-text">{collection.name}</li>
    </ol>
  </nav>

  <section class="canvas-panel mt-6 overflow-hidden">
    <img src={collection.image.src} alt={collection.image.alt} width="1600" height="500" class="h-56 w-full object-cover opacity-80 sm:h-72" />
    <div class="p-6 sm:p-8">
      <p class="eyebrow">{collection.kicker}</p>
      <h1 class="mt-2 text-3xl font-extrabold text-white sm:text-4xl">{collection.name}</h1>
      <p class="mt-2 max-w-2xl text-body-lg text-white/80">{collection.description}</p>
      <p class="mt-3 text-body-md font-semibold text-cyan">{collection.offer}</p>
    </div>
  </section>

  <div class="mt-8">
    <CatalogFilters client:load />
  </div>
  <ul class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {products.map((product) => <li><ProductCard product={product} /></li>)}
  </ul>
</BaseLayout>
