---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProducts } from '../../lib/catalog';
import { collections, productsForCollection } from '../../lib/collections';

const products = await getProducts();
---

<BaseLayout
  title="Collections"
  description="Shop the ChainShirts collections: Public Safety, Desk Dominion and Neon Nights."
  path="/collections"
>
  <p class="eyebrow">Curated for you</p>
  <h1 class="mt-2 text-display font-bold text-text">Collections</h1>
  <p class="mt-2 max-w-2xl text-body-lg text-muted">Every drop, every colourway, one place. Find the collection that fits your rotation.</p>

  <ul class="mt-8 grid gap-6 md:grid-cols-3">
    {collections.map((collection) => {
      const items = productsForCollection(collection, products);
      return (
        <li>
          <a href={`/collections/${collection.slug}`} class="surface-card group block h-full overflow-hidden no-underline">
            <img src={collection.image.src} alt={collection.image.alt} width="1600" height="500" loading="lazy" class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="p-6">
              <p class="text-body-sm font-bold uppercase tracking-widest text-muted">{collection.kicker}</p>
              <h2 class="mt-1 text-heading-lg font-bold text-text">{collection.name}</h2>
              <p class="mt-2 text-body-md text-muted">{collection.description}</p>
              <p class="mt-3 text-body-sm font-semibold text-success">{collection.offer}</p>
              <p class="mt-4 text-body-md font-bold text-link">{items.length} pieces →</p>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>
