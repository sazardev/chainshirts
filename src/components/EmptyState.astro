---
interface Props {
  title: string;
  description: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, description, actionLabel, actionHref } = Astro.props;
---

<div class="surface-card mx-auto flex max-w-sm flex-col items-center gap-3 p-6 text-center" role="status">
  <h2 class="text-heading-lg font-semibold text-text">{title}</h2>
  <p class="text-body-md text-muted">{description}</p>
  {actionLabel && actionHref && (
    <a
      href={actionHref}
      class="inline-flex min-h-11 items-center rounded-md bg-brand px-4 text-body-md font-semibold text-on-brand hover:bg-brand-hover"
    >
      {actionLabel}
    </a>
  )}
</div>
