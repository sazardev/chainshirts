---
import { categoryLabel } from '../lib/catalog';
import { formatMoney } from '../lib/domain/money';
import { COLOR_SWATCH, discountPercent, type Product } from '../lib/domain/product';
import AddToCartButton from './islands/AddToCartButton';
import LikeButton from './islands/LikeButton';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const discount = discountPercent(product);
const instalment = formatMoney(Math.round(product.priceMinor / 3));
---

<article
  class="surface-card flex h-full flex-col overflow-hidden transition-transform duration-normal hover:-translate-y-0.5"
  data-product-card
  data-product-name={product.name}
  data-price={product.priceMinor / 100}
  data-brand={product.brand}
  data-rating={product.rating}
  data-onsale={discount > 0 ? 'true' : 'false'}
  data-colour={product.colors.join(',')}
>
  <a href={`/products/${product.slug}`} class="group relative block overflow-hidden bg-canvas">
    <img
      src={product.images[0]?.src ?? ''}
      alt={product.images[0]?.alt ?? product.name}
      width="800"
      height="1000"
      loading="lazy"
      decoding="async"
      class="aspect-4/5 w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
    <span class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-canvas/70 to-transparent" aria-hidden="true"></span>
    <span class="absolute left-3 top-3 rounded-full bg-canvas/85 px-2 py-1 text-body-sm font-semibold text-accent-text backdrop-blur-sm">
      {categoryLabel(product.category)}
    </span>
    {discount > 0 && (
      <span class="absolute bottom-3 left-3 rounded bg-danger px-2 py-0.5 text-body-sm font-bold text-on-brand">
        −{discount}%
      </span>
    )}
    {product.badge && discount === 0 && (
      <span class="absolute right-3 top-3 rounded-full bg-brand px-2 py-1 text-body-sm font-bold text-on-brand">
        {product.badge}
      </span>
    )}
  </a>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <p class="text-body-sm font-semibold uppercase tracking-wide text-muted">{product.brand}</p>
    <h3 class="text-heading-md font-semibold leading-snug text-text">
      <a href={`/products/${product.slug}`} class="text-inherit no-underline hover:text-link">
        {product.name}
      </a>
    </h3>

    <div class="flex items-center gap-1 text-body-sm text-muted" aria-label={`Rated ${product.rating} out of 5`}>
      <span class="text-warning" aria-hidden="true">★★★★★</span>
      <span class="font-semibold text-text">{product.rating.toFixed(1)}</span>
      <span>({product.reviewCount})</span>
    </div>

    <div class="flex flex-wrap items-baseline gap-2">
      <p class="text-body-lg font-bold tabular-nums text-text">{formatMoney(product.priceMinor, product.currency)}</p>
      {discount > 0 && (
        <p class="text-body-sm text-muted line-through">{formatMoney(product.compareAtPriceMinor, product.currency)}</p>
      )}
    </div>
    <p class="text-body-sm text-success">or 3 × {instalment} · Free shipping</p>
    <p class="line-clamp-2 text-body-sm text-muted">{product.description}</p>

    {product.colors.length > 1 && (
      <div class="flex items-center gap-1" role="group" aria-label={`${product.colors.length} colours available`}>
        {product.colors.map((color) => (
          <span class={`h-3 w-3 rounded-full border ${COLOR_SWATCH[color]}`} title={color} aria-hidden="true" />
        ))}
      </div>
    )}

    <div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
      <LikeButton product={product} compact client:only="preact" />
      <AddToCartButton product={product} client:visible />
    </div>
  </div>
</article>
