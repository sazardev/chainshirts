---
import type { ComponentChildren } from 'preact';

interface Props {
  tone?: 'info' | 'warning' | 'critical';
  title: string;
  children: ComponentChildren;
}

const { tone = 'info', title, children } = Astro.props;
const toneClass = {
  info: 'border-link/40 bg-link/10 text-text',
  warning: 'border-warning/60 bg-warning/15 text-text',
  critical: 'border-danger/60 bg-danger/10 text-critical',
}[tone];
---

<div class={`flex min-h-12 items-start gap-3 rounded-md border px-4 py-3 ${toneClass}`} role={tone === 'critical' ? 'alert' : 'status'}>
  <span aria-hidden="true">{tone === 'critical' ? '✕' : tone === 'warning' ? '!' : 'i'}</span>
  <div>
    <p class="text-body-md font-semibold">{title}</p>
    <p class="text-body-sm text-muted">{children}</p>
  </div>
</div>
