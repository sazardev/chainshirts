{
  "name": "chainshirts",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "ChainShirts — an offline, static, Chainsaw Man themed mock fashion store built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/make-relative.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "sync": "astro sync",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --noEmit",
    "typecheck:watch": "node ./node_modules/typescript7/bin/tsc --noEmit --watch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "hooks": "lefthook install",
    "art": "python3 scripts/fetch-stock.py && python3 scripts/fetch-more.py && python3 scripts/fetch-galleries.py",
    "deploy": "wrangler pages deploy dist --project-name chainshirts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/preact": "^4.1.3",
    "@astrojs/sitemap": "^3.7.5",
    "@preact/signals": "^2.11.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^5.18.2",
    "preact": "^10.29.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "lefthook": "^2.2.2",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
